{
  "expo": {
    "name": "TuS2 by Mimo",
    "slug": "TusApp-Oktober26-vers.5.04",
    "owner": "mimo20000",
    "version": "5.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mimo20000.tus2bymimo",
      "buildNumber": "5.0.6",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Profilfoto aus deiner Galerie auswählen"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#C22520"
      },
      "versionCode": 506,
      "package": "com.mimo20000.tus2bymimo"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#C22520"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#DA291C"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profilfoto aus deiner Galerie auswählen"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
